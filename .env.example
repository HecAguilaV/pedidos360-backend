# ==============================================================================
# Pedidos360 — Cloud Native Deployment Configuration (.env.example)
# Copy this file to .env (or run ./configure-lab.sh) before running:
#   docker compose up --build -d
# ==============================================================================

# 1. Runtime Profile (dev = local open APIs, prod = strict JWT validation on AWS)
SPRING_PROFILES_ACTIVE=dev

# 2. JVM Memory Tuning (prevents OOM on AWS EC2 t3.medium 4GB RAM)
JDK_JAVA_OPTIONS=-Xms64m -Xmx192m -XX:+UseSerialGC -Xss512k

# 3. PostgreSQL / Amazon RDS & RabbitMQ Credentials
# Local Docker default: DB_HOST=postgres
# Amazon RDS example:   DB_HOST=pedidos360-db.xxxx.us-east-1.rds.amazonaws.com
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 4. SMTP Email Configuration (notifications-service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# 5. Dual Identity Providers (Microsoft Entra ID + AWS Cognito)
# Note: Frontend Entra ID config lives in src/environments/environment.prod.ts.
# For AWS deployments where Entra ID requires HTTPS (MSAL + window.crypto.subtle),
# place an AWS CloudFront distribution in front of the EC2 HTTP origin to obtain
# https://<id>.cloudfront.net and register that URL in Azure Entra ID Redirect URIs.
JWT_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
JWT_AUDIENCE=api://<CLIENT_ID>,<CLIENT_ID>

# AWS Cognito User Pool (Injected at runtime into frontend /assets/runtime-config.json
# via docker-entrypoint.d/40-runtime-config.sh — rotates with zero image rebuild!)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
COGNITO_SCOPES=openid profile email

# 6. Allowed CORS Origins (comma-separated patterns; supports EC2 IPs, CloudFront & API Gateway)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost:8080,http://localhost,http://*:4200,http://*:80,http://*:8080,https://*.amazonaws.com,https://*.cloudfront.net
