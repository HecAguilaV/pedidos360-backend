# ==============================================================================
# Pedidos360 — Cloud Native Deployment Configuration (.env.example)
# Copy this file to .env before running: docker compose up --build -d
# ==============================================================================

# 1. Runtime Profile (dev = local/demo open APIs, prod = strict JWT validation)
SPRING_PROFILES_ACTIVE=dev

# 2. JVM Memory Tuning (prevents OOM on AWS EC2 t3.medium 4GB RAM)
JDK_JAVA_OPTIONS=-Xms64m -Xmx192m -XX:+UseSerialGC -Xss512k

# 3. Database & RabbitMQ Credentials
DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 4. SMTP Email Configuration (notifications-service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# 5. Dual Identity Providers (Microsoft Entra ID + AWS Cognito)
JWT_ISSUER=https://login.microsoftonline.com/e5372bf0-c5e3-4286-887c-79069f209c1f/v2.0
JWT_AUDIENCE=api://4c9cb95d-2a2e-4f3c-88eb-1fbe551829b5,4c9cb95d-2a2e-4f3c-88eb-1fbe551829b5

# AWS Cognito User Pool (Customer Identity Provider)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# 6. Allowed CORS Origins (comma-separated patterns; supports EC2 IPs & API Gateway)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost:8080,http://localhost,http://*:4200,http://*:80,http://*:8080,https://*.amazonaws.com
