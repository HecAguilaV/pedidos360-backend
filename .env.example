# ==============================================================================
# Pedidos360 Backend Environment Variables
# ==============================================================================
# Database Configuration (Local Docker / AWS RDS PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Microsoft Entra ID / JWT Validation (Section 24)
# When deploying to AWS / connecting to Azure Entra ID, fill in these values:
JWT_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
JWT_AUDIENCE=api://YOUR_BACKEND_CLIENT_ID

# Spring Profile: 'dev' (local test without Azure) or 'prod' (strict Azure JWT validation)
SPRING_PROFILES_ACTIVE=dev
